# Raw dataset is several GB -- never commit it, download instructions live in README
data/raw/*
!data/raw/.gitkeep

# Processed data can also be large
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts (regenerated by the notebooks -- no need to version them)
models/**/*.joblib
models/**/*.pkl
models/**/*.csv
models/**/*.json
!models/**/.gitkeep

# Generated figures
reports/figures/*.png
!reports/figures/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS/editor cruft
.DS_Store
.vscode/

# Virtual environment
venv/
.venv/